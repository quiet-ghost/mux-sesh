{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/quiet-ghost/mux-sesh/raw/master/mux-sesh.schema.json",
  "title": "mux-sesh configuration",
  "type": "object",
  "properties": {
    "backend": {
      "type": "string",
      "enum": ["tmux", "herdr"],
      "description": "\"tmux\" or \"herdr\""
    },
    "project_paths": {
      "type": "array",
      "description": "a list of non-empty strings",
      "items": { "type": "string", "minLength": 1, "description": "a non-empty string" }
    },
    "projectPaths": {
      "type": "array",
      "description": "a list of non-empty strings",
      "items": { "type": "string", "minLength": 1, "description": "a non-empty string" }
    },
    "repos_path": { "type": "string", "description": "text" },
    "reposPath": { "type": "string", "description": "text" },
    "editor": { "type": "string", "description": "text" },
    "editor_cmd": { "type": "string", "description": "text" },
    "editorCmd": { "type": "string", "description": "text" },
    "keybind_mode": {
      "type": "string",
      "enum": ["vim", "standard"],
      "description": "\"vim\" or \"standard\""
    },
    "keybindMode": {
      "type": "string",
      "enum": ["vim", "standard"],
      "description": "\"vim\" or \"standard\""
    },
    "prefix_key": { "type": "string", "description": "text" },
    "prefixKey": { "type": "string", "description": "text" },
    "zoxide_mode": {
      "type": "string",
      "enum": ["off", "rank", "merge"],
      "description": "\"off\" or \"rank\" or \"merge\""
    },
    "zoxideMode": {
      "type": "string",
      "enum": ["off", "rank", "merge"],
      "description": "\"off\" or \"rank\" or \"merge\""
    },
    "sort_order": {
      "type": "string",
      "enum": ["live-first", "configured-first", "zoxide-first", "alphabetical"],
      "description": "\"live-first\" or \"configured-first\" or \"zoxide-first\" or \"alphabetical\""
    },
    "sortOrder": {
      "type": "string",
      "enum": ["live-first", "configured-first", "zoxide-first", "alphabetical"],
      "description": "\"live-first\" or \"configured-first\" or \"zoxide-first\" or \"alphabetical\""
    },
    "theme": { "type": "string", "description": "text" },
    "color_scheme": {
      "type": "string",
      "enum": ["light", "dark", "system"],
      "description": "\"light\" or \"dark\" or \"system\""
    },
    "colorScheme": {
      "type": "string",
      "enum": ["light", "dark", "system"],
      "description": "\"light\" or \"dark\" or \"system\""
    },
    "themes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "description": "text" },
          "light": {
            "type": "object",
            "properties": {
              "palette": {
                "type": "object",
                "properties": {
                  "neutral": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "ink": { "type": "string", "minLength": 1, "description": "a non-empty string" },
                  "primary": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "success": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "warning": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "error": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "info": { "type": "string", "minLength": 1, "description": "a non-empty string" },
                  "accent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "interactive": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "diffAdd": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "diffDelete": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  }
                },
                "required": ["neutral", "ink", "primary", "success", "warning", "error", "info"],
                "additionalProperties": true,
                "description": "a palette object"
              },
              "overrides": {
                "type": "object",
                "additionalProperties": { "type": "string", "description": "text" }
              }
            },
            "required": ["palette"],
            "additionalProperties": true,
            "description": "a theme variant object"
          },
          "dark": {
            "type": "object",
            "properties": {
              "palette": {
                "type": "object",
                "properties": {
                  "neutral": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "ink": { "type": "string", "minLength": 1, "description": "a non-empty string" },
                  "primary": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "success": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "warning": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "error": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "info": { "type": "string", "minLength": 1, "description": "a non-empty string" },
                  "accent": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "interactive": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "diffAdd": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  },
                  "diffDelete": {
                    "type": "string",
                    "minLength": 1,
                    "description": "a non-empty string"
                  }
                },
                "required": ["neutral", "ink", "primary", "success", "warning", "error", "info"],
                "additionalProperties": true,
                "description": "a palette object"
              },
              "overrides": {
                "type": "object",
                "additionalProperties": { "type": "string", "description": "text" }
              }
            },
            "required": ["palette"],
            "additionalProperties": true,
            "description": "a theme variant object"
          }
        },
        "required": ["light", "dark"],
        "additionalProperties": true,
        "description": "a theme object with light and dark variants"
      }
    },
    "auto_update": { "type": "boolean", "description": "true or false" },
    "autoUpdate": { "type": "boolean", "description": "true or false" },
    "search_history": { "type": "boolean", "description": "true or false" },
    "searchHistory": { "type": "boolean", "description": "true or false" },
    "dir_length": {
      "type": "integer",
      "maximum": 9007199254740991,
      "exclusiveMinimum": 0,
      "description": "a whole number of at least 1"
    },
    "dirLength": {
      "type": "integer",
      "maximum": 9007199254740991,
      "exclusiveMinimum": 0,
      "description": "a whole number of at least 1"
    },
    "hidden_sessions": {
      "type": "array",
      "description": "a list of non-empty strings",
      "items": { "type": "string", "minLength": 1, "description": "a non-empty string" }
    },
    "hiddenSessions": {
      "type": "array",
      "description": "a list of non-empty strings",
      "items": { "type": "string", "minLength": 1, "description": "a non-empty string" }
    },
    "pinned_sessions": {
      "type": "array",
      "description": "a list of non-empty strings",
      "items": { "type": "string", "minLength": 1, "description": "a non-empty string" }
    },
    "pinnedSessions": {
      "type": "array",
      "description": "a list of non-empty strings",
      "items": { "type": "string", "minLength": 1, "description": "a non-empty string" }
    },
    "icons": {
      "type": "object",
      "properties": {
        "tmux": { "type": "string", "description": "text" },
        "herdr": { "type": "string", "description": "text" },
        "configured": { "type": "string", "description": "text" },
        "config": { "type": "string", "description": "text" },
        "project": { "type": "string", "description": "text" },
        "opencode": { "type": "string", "description": "text" }
      },
      "additionalProperties": true,
      "description": "an icons object"
    },
    "default_session": {
      "type": "object",
      "properties": {
        "startup_command": { "type": "string", "description": "text" },
        "startupCommand": { "type": "string", "description": "text" },
        "preview_command": { "type": "string", "description": "text" },
        "previewCommand": { "type": "string", "description": "text" }
      },
      "additionalProperties": true,
      "description": "a default session object"
    },
    "defaultSession": {
      "type": "object",
      "properties": {
        "startup_command": { "type": "string", "description": "text" },
        "startupCommand": { "type": "string", "description": "text" },
        "preview_command": { "type": "string", "description": "text" },
        "previewCommand": { "type": "string", "description": "text" }
      },
      "additionalProperties": true,
      "description": "a default session object"
    },
    "projects": {
      "type": "array",
      "description": "a list of project objects",
      "items": {
        "type": "object",
        "properties": {
          "path": { "type": "string", "minLength": 1, "description": "a non-empty string" },
          "session_name": { "type": "string", "description": "text" },
          "sessionName": { "type": "string", "description": "text" },
          "startup_command": { "type": "string", "description": "text" },
          "startupCommand": { "type": "string", "description": "text" },
          "preview_command": { "type": "string", "description": "text" },
          "previewCommand": { "type": "string", "description": "text" },
          "listed": { "type": "boolean", "description": "true or false" },
          "icon": { "type": "string", "description": "text" }
        },
        "required": ["path"],
        "additionalProperties": true,
        "description": "a project object"
      }
    },
    "wildcards": {
      "type": "array",
      "description": "a list of wildcard objects",
      "items": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string", "minLength": 1, "description": "a non-empty string" },
          "session_name": { "type": "string", "description": "text" },
          "sessionName": { "type": "string", "description": "text" },
          "startup_command": { "type": "string", "description": "text" },
          "startupCommand": { "type": "string", "description": "text" },
          "preview_command": { "type": "string", "description": "text" },
          "previewCommand": { "type": "string", "description": "text" }
        },
        "required": ["pattern"],
        "additionalProperties": true,
        "description": "a wildcard object"
      }
    }
  },
  "additionalProperties": true,
  "description": "a JSON object"
}
