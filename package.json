{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "mux-sesh",
  "version": "1.10.0",
  "description": "An OpenTUI manager for tmux sessions and Herdr workspaces with fuzzy project search",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "bin": {
    "mux-sesh": "./bin/mux-sesh"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "MUX_SESH_DEV=1 bun run src/index.tsx",
    "build": "bun build src/index.tsx --compile --outfile dist/mux-sesh",
    "start": "bun run src/index.tsx",
    "lint": "bun run --bun oxlint",
    "lint:corridor": "bun tools/oxlint/lint-corridor.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "bench:picker": "bun tests/perf/run-baseline.ts",
    "prepublishOnly": "bun run typecheck"
  },
  "keywords": [
    "tmux",
    "herdr",
    "tui",
    "terminal",
    "session-manager",
    "workspace-manager",
    "opentui",
    "cli",
    "tmux-manager",
    "terminal-ui",
    "fuzzy-search",
    "project-manager"
  ],
  "author": "quiet-ghost",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quiet-ghost/mux-sesh.git"
  },
  "bugs": {
    "url": "https://github.com/quiet-ghost/mux-sesh/issues"
  },
  "homepage": "https://github.com/quiet-ghost/mux-sesh#readme",
  "engines": {
    "bun": ">=1.3.14"
  },
  "overrides": {
    "@types/node": "^24"
  },
  "dependencies": {
    "@ff-labs/fff-bun": "0.10.1",
    "@opentui/core": "0.5.17",
    "@opentui/react": "0.5.17",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.17",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  }
}
